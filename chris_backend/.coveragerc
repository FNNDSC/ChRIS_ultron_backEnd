# Coverage config for local dev (volume-mounted, not in Docker image).
# The canonical config lives in setup.cfg so it is available inside the
# container during CI runs (.coveragerc is excluded by .dockerignore).
# This file is kept only as a fallback for tools that read .coveragerc directly.

[run]
source_pkgs =
    collectionjson
    core
    dicomweb
    feeds
    filebrowser
    pacsfiles
    pipelines
    plugininstances
    plugins
    userfiles
    users
    workflows
omit =
    */migrations/*
    */tests/*

[report]
show_missing = True
skip_empty = True
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
    raise NotImplementedError
